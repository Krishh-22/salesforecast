import { generateSampleCsv, parseCsv, detectColumns, buildSeries } from '../src/lib/forecast/data.ts';
import { profileSeries, seriesToCsv } from '../src/lib/forecast/profile.ts';
let fail = 0; const ok = (c: boolean, m: string) => { console.log((c ? 'PASS ' : 'FAIL ') + m); if (!c) fail++; };
const t = parseCsv(generateSampleCsv()); const det = detectColumns(t); const s = buildSeries(t, det, det.dateOrder).series!;
const p = profileSeries(s)!;
ok(p.weeks === s.values.length && p.first === s.weeks[0] && p.last === s.weeks[s.weeks.length - 1], 'weeks/first/last');
ok(Math.abs(p.total - s.values.reduce((a, b) => a + b, 0)) < 1e-6, 'total matches');
ok(p.min.value <= p.median && p.median <= p.max.value, 'min <= median <= max');
ok(p.trendPerYearPct! > 0 && p.trendPerYearPct! < 60, 'sample data has growth: ' + p.trendPerYearPct?.toFixed(1) + '%/yr');
ok(p.categories.length === 4 && Math.abs(p.categories.reduce((a, c) => a + c.sharePct, 0) - 100) < 1e-6, 'category shares sum to 100%');
ok(p.categories[0].name === 'Electronics', 'largest category first: ' + p.categories[0].name);
ok(p.spark.length <= 61 && p.spark.length > 10, 'sparkline downsampled to ' + p.spark.length);
const spike = { ...s, values: s.values.map((v, i) => (i === 20 ? v * 10 : v)) };
ok(profileSeries(spike)!.outlierWeeks.some(o => o.week === s.weeks[20]), 'injected spike is flagged as an outlier');
ok(profileSeries({ ...s, values: [], weeks: [] }) === null, 'empty series -> null');
const flat = profileSeries({ weeks: ['2024-01-01','2024-01-08'], values: [0, 0], categories: [], dateColumn: 'd', valueColumn: 'v', categoryColumn: null })!;
ok(flat.zeroWeeks === 2 && flat.trendPerYearPct === null && !Number.isNaN(flat.std), 'zeros handled, no NaN');
const csv = seriesToCsv(s).split('\n');
ok(csv[0] === 'week_starting,revenue,Electronics,Clothing,Home & Kitchen,Grocery' && csv.length === s.weeks.length + 1, 'series csv shape');
console.log(fail === 0 ? '\nALL PASSED' : `\n${fail} FAILED`); process.exit(fail ? 1 : 0);
